		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02&amp;\x00\x00\x00\xb0\x00\x00\x05E\x00\x00\x03&amp;\x00\x00\x02&amp;\x00\x00\x00\xcf\x00\x00\x05E\x00\x00\x03&amp;\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02&amp;\x00\x00\x00\xcf\x00\x00\x05E\x00\x00\x03&amp;', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table\n\ndata = in_data.copy()\nX = data.X.copy()\n\n# nombres de columnas a corregir\ncols_to_fix = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI"]\n\n# obtener índices\ndomain = data.domain\nindices = [i for i, var in enumerate(domain.attributes) if var.name in cols_to_fix]\n\nfor col in indices:\n    X[:, col][X[:, col] == 0] = np.nan\n\ndata.X = X\nout_data = data', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table\n\ndata = in_data.copy()\nX = data.X.copy()\n\n# nombres de columnas a corregir\ncols_to_fix = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI"]\n\n# obtener índices\ndomain = data.domain\nindices = [i for i, var in enumerate(domain.attributes) if var.name in cols_to_fix]\n\nfor col in indices:\n    X[:, col][X[:, col] == 0] = np.nan\n\ndata.X = X\nout_data = data', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x94\x00\x00\x00R\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>

		<properties node_id="17" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02&amp;\x00\x00\x00\xb0\x00\x00\x05\xb2\x00\x00\x03\xa8\x00\x00\x02&amp;\x00\x00\x00\xcf\x00\x00\x05\xb2\x00\x00\x03\xa8\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02&amp;\x00\x00\x00\xcf\x00\x00\x05\xb2\x00\x00\x03\xa8', 'scriptLibrary': [{'name': 'Correlation Matrix for Heat Map', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable\n\nattr_names = [a.name for a in in_data.domain.attributes]\nX = in_data.X.copy()\n\ncorr = np.corrcoef(X, rowvar=False)\n\ndomain = Domain(\n    [ContinuousVariable(name) for name in attr_names],\n    metas=[StringVariable("Variable")]\n)\n\nmetas = np.array(attr_names, dtype=object).reshape(-1, 1)\n\nout_data = Table.from_numpy(domain, corr, metas=metas)', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable\n\nattr_names = [a.name for a in in_data.domain.attributes]\nX = in_data.X.copy()\n\ncorr = np.corrcoef(X, rowvar=False)\n\ndomain = Domain(\n    [ContinuousVariable(name) for name in attr_names],\n    metas=[StringVariable("Variable")]\n)\n\nmetas = np.array(attr_names, dtype=object).reshape(-1, 1)\n\nout_data = Table.from_numpy(domain, corr, metas=metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x94\x00\x00\x00R\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>

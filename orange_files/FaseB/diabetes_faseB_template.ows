		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xfcz\x00\x00\x00\x00\xff\xff\xff\xf4\x00\x00\x04\x06\xff\xff\xfcz\x00\x00\x00\x1f\xff\xff\xff\xf4\x00\x00\x04\x06\x00\x00\x00\x01\x00\x00\x00\x00\x07\x80\xff\xff\xfcz\x00\x00\x00\x1f\xff\xff\xff\xf4\x00\x00\x04\x06', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table\n\nX = in_data.X.copy()\n\nattr_names = [a.name for a in in_data.domain.attributes]\ncols_by_name = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI"]\n\nfor col_name in cols_by_name:\n    col = attr_names.index(col_name)\n    median_val = np.nanmedian(X[:, col])\n    print(f"{col_name}: mediana usada = {median_val}")\n    X[:, col] = np.where(np.isnan(X[:, col]), median_val, X[:, col])\n\nout_data = Table.from_numpy(\n    in_data.domain,\n    X,\n    in_data.Y,\n    in_data.metas\n)', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table\n\nX = in_data.X.copy()\n\nattr_names = [a.name for a in in_data.domain.attributes]\ncols_by_name = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI"]\n\nfor col_name in cols_by_name:\n    col = attr_names.index(col_name)\n    median_val = np.nanmedian(X[:, col])\n    print(f"{col_name}: mediana usada = {median_val}")\n    X[:, col] = np.where(np.isnan(X[:, col]), median_val, X[:, col])\n\nout_data = Table.from_numpy(\n    in_data.domain,\n    X,\n    in_data.Y,\n    in_data.metas\n)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x94\x00\x00\x00R\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
